+def _scope() -> Scope:
+    return {
+        'type': 'http',
+        'asgi': {'version': '3.0', 'spec_version': '2.4'},
+        'http_version': '1.1',
+        'method': 'POST',
+        'scheme': 'http',
+        'path': '/',
+        'raw_path': b'/',
+        'root_path': '',
+        'query_string': b'',
+        'headers': [],
+        'server': ('testserver', 80),
+        'client': ('testclient', 123),
+    }
+
+
+async def _receive() -> Message:
+    await anyio.Event().wait()
+    raise AssertionError('A completed response must retire its receive waiter')
+
