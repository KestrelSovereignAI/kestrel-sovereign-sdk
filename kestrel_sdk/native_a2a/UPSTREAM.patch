+++ b/tests/server/test_cross_event_loop_locks.py
@@ -31,7 +31,8 @@ class _PersistentLoop:
 
     def _run(self) -> None:
         asyncio.set_event_loop(self._loop)
-        self._loop.run_forever()
+        with asyncio.Runner(loop_factory=lambda: self._loop):
+            self._loop.run_forever()
 
     def run(self, coro, timeout: float = 10):
         """Runs coro to completion on this loop and returns its result."""
@@ -39,9 +40,93 @@ class _PersistentLoop:
             timeout=timeout
         )
 
-    def close(self) -> None:
+    def close(self, timeout: float = 10) -> None:
         self._loop.call_soon_threadsafe(self._loop.stop)
-        self._thread.join(timeout=10)
+        self._thread.join(timeout=timeout)
+        if self._thread.is_alive():
+            raise TimeoutError(
+                'Original cross-loop thread did not finish shutdown'
+            )
+
+
+@pytest.mark.parametrize('fails', [False, True])
+def test_persistent_loop_retires_original_loop_and_executor(
+    fails: bool,
+) -> None:
+    owner = _PersistentLoop()
+    original_loop = owner._loop
+    original_workers = []
+    original_result = object()
+    original_error = ValueError('original cross-loop operation failed')
+
+    async def original_operation() -> object:
+        original_workers.append(
+            await asyncio.get_running_loop().run_in_executor(
+                None, threading.current_thread
+            )
+        )
+        if fails:
+            raise original_error
+        return original_result
+
+    try:
+        if fails:
+            with pytest.raises(ValueError) as captured:
+                owner.run(original_operation())
+            assert captured.value is original_error
+        else:
+            assert owner.run(original_operation()) is original_result
+        owner.close()
+        assert not owner._thread.is_alive()
+        assert original_loop.is_closed(), (
+            'original loop remains open after its owner joined'
+        )
+        assert len(original_workers) == 1
+        assert not original_workers[0].is_alive()
+    finally:
+        if owner._thread.is_alive():
+            owner.close()
+        if not original_loop.is_closed():
+            # Retire the actual leaked test resource only after the failed
+            # observation, rather than leave it for an unrelated test's GC.
+            original_loop.run_until_complete(
+                original_loop.shutdown_default_executor()
+            )
+            original_loop.close()
+
+
+def test_persistent_loop_timeout_does_not_claim_original_executor_retirement() -> (
+    None
+):
+    owner = _PersistentLoop()
+    entered, release = threading.Event(), threading.Event()
+    original_workers = []
+
+    def original_worker() -> None:
+        original_workers.append(threading.current_thread())
+        entered.set()
+        release.wait()
+
+    async def original_operation() -> None:
+        await asyncio.get_running_loop().run_in_executor(None, original_worker)
+
+    pending = asyncio.run_coroutine_threadsafe(
+        original_operation(), owner._loop
+    )
+    try:
+        assert entered.wait(5)
+        with pytest.raises(TimeoutError, match='Original cross-loop thread'):
+            owner.close(timeout=0)
+        assert owner._thread.is_alive()
+        assert original_workers[0].is_alive()
+        assert not owner._loop.is_closed()
+    finally:
+        release.set()
+        owner._thread.join(timeout=10)
+    assert not owner._thread.is_alive()
+    assert not original_workers[0].is_alive()
+    assert owner._loop.is_closed()
+    assert pending.done()
 
 
