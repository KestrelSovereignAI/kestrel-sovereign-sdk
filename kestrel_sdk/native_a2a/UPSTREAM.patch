+@pytest.mark.asyncio
+async def test_rest_error_handler_reraises_http_exception():
+    """The ASGI app keeps the status and challenge headers of HTTP errors."""
+    from starlette.exceptions import HTTPException
+
+    @rest_error_handler
+    async def deny():
+        raise HTTPException(status_code=401, headers={'WWW-Authenticate': 'x'})
+
+    with pytest.raises(HTTPException) as excinfo:
+        await deny()
+    assert excinfo.value.status_code == 401
+
+
+@pytest.mark.asyncio
+async def test_rest_error_handler_media_type():
+    async def fail():
+        raise InvalidRequestError(message='Bad request')
+
+    response = await rest_error_handler(fail, 'application/a2a+json')()
+    assert response.media_type == 'application/a2a+json'
