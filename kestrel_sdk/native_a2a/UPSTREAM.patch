diff --git a/src/a2a/utils/source_lifetime.py b/src/a2a/utils/source_lifetime.py
new file mode 100644
index 0000000..e3da46e
--- /dev/null
+++ b/src/a2a/utils/source_lifetime.py
@@ -0,0 +1,284 @@
+"""Standalone backend ownership for the shared original-source body.
+
+The enclosing context belongs to the request's complete ASGI lifetime, not
+only its endpoint call. A host with its own admission/authority policy supplies
+its own adapter; this standalone AnyIO policy grants no host authority.
+"""
+
+from __future__ import annotations
+
+from builtins import BaseExceptionGroup
+from collections.abc import AsyncIterable, AsyncIterator, Callable
+from contextlib import AbstractAsyncContextManager, asynccontextmanager
+from typing import TYPE_CHECKING, Generic, Protocol, TypeVar, cast
+
+from a2a.utils.source_ownership import (
+    CallbackSource,
+    SourceAcquisition,
+    SourceBodyOutcome,
+    SourceHandoff,
+    run_source_body,
+)
+
+
+if TYPE_CHECKING:
+    from anyio.abc import TaskStatus
+
+
+T = TypeVar('T')
+T_co = TypeVar('T_co', covariant=True)
+SourceFactory = Callable[
+    [SourceAcquisition], AsyncIterable[T] | CallbackSource[T]
+]
+
+
+class SourceDemand(Protocol[T_co]):
+    """Borrowed demand only; the enclosing policy owns physical retirement."""
+
+    def __aiter__(self) -> AsyncIterator[T_co]:
+        """Return an asynchronous demand reader without a second close."""
+        ...
+
+    async def __anext__(self) -> T_co:
+        """Read one frame or a physically joined original failure."""
+        ...
+
+    def request_stop(self) -> None:
+        """Withdraw demand, without acknowledging physical retirement."""
+        ...
+
+    def raise_if_retirement_failed(self) -> None:
+        """Raise known original retirement failures, never a body projection."""
+        ...
+
+
+class SourceLifetimeFactory(Protocol):
+    """Explicit caller-selected admission and physical-retirement policy."""
+
+    def __call__(
+        self, acquire: SourceFactory[T]
+    ) -> AbstractAsyncContextManager[SourceDemand[T]]:
+        """Retain the actual source owner until the enclosing context exits."""
+        ...
+
+
+def _original_errors(errors: list[BaseException]) -> BaseException | None:
+    """Retain original graphs without mutating their causes or tracebacks."""
+
+    def contains_original(graph: BaseException, target: BaseException) -> bool:
+        pending = [graph]
+        visited: set[int] = set()
+        while pending:
+            current = pending.pop()
+            if current is target:
+                return True
+            if id(current) in visited:
+                continue
+            visited.add(id(current))
+            if isinstance(current, BaseExceptionGroup):
+                pending.extend(
+                    BaseExceptionGroup.__dict__['exceptions'].__get__(current)
+                )
+            cause = BaseException.__dict__['__cause__'].__get__(current)
+            if cause is not None:
+                pending.append(cause)
+        return False
+
+    originals: list[BaseException] = []
+    for error in errors:
+        if not any(
+            contains_original(original, error) for original in originals
+        ):
+            originals.append(error)
+    if not originals:
+        return None
+    if len(originals) == 1:
+        return originals[0]
+    return BaseExceptionGroup('Original source lifetime failures', originals)
+
+
+class _SourceRuntime(Generic[T]):
+    def __init__(self, acquire: SourceFactory[T]) -> None:
+        import anyio  # noqa: PLC0415 -- optional backend, not a base import
+
+        if not callable(acquire):
+            raise TypeError('An original source requires a callable factory')
+        self.acquire = acquire
+        self.handoff = SourceHandoff[T]()
+        self.dispatch = anyio.Event()
+        self.joined = anyio.Event()
+        self.outcome: SourceBodyOutcome | None = None
+        self.backend_errors: list[BaseException] = []
+        self._terminal_error: BaseException | None = None
+
+    async def run(self, *, task_status: TaskStatus[None]) -> None:
+        """Enter the original Task before dispatching any factory code."""
+        task_status.started()
+        # Cancellation before admission cannot enter an unknown source finally:
+        # the source and its shield do not exist on this side of the gate.
+        await self.dispatch.wait()
+        if not self.handoff.stopped:
+            self.outcome = await run_source_body(self.acquire, self.handoff)
+
+    async def monitor(self, *, task_status: TaskStatus[None]) -> None:
+        """Publish terminal demand only after the ORIGINAL Task group joins."""
+        import anyio  # noqa: PLC0415 -- optional backend
+
+        announced = False
+        try:
+            with anyio.CancelScope(shield=True):
+                async with anyio.create_task_group() as original:
+                    await original.start(self.run)
+                    task_status.started()
+                    announced = True
+                # The monitor owns the entire original Task, including any
+                # epilogue after the shared body shield has exited. Observer
+                # scope cancellation cannot replace that physical join.
+        except BaseException as error:
+            if not announced:
+                # The start waiter needs the actual failure, not a normal
+                # return that manufactures a missing-start announcement error.
+                raise
+            self.backend_errors.append(error)
+        finally:
+            self.handoff.publish_terminal()
+            self.joined.set()
+
+    def terminal_error(self) -> BaseException | None:
+        """Read the outcome only after the original group's physical join."""
+        if not self.joined.is_set():
+            raise RuntimeError('The original source owner is not joined')
+        if self._terminal_error is None:
+            errors = list(self.backend_errors)
+            if self.outcome is not None:
+                errors.extend(
+                    error
+                    for error in (
+                        self.outcome.body_error,
+                        *self.outcome.retirement_errors,
+                        *self.outcome.observation_errors,
+                    )
+                    if error is not None
+                )
+            self._terminal_error = _original_errors(errors)
+        return self._terminal_error
+
+    async def observe_join(self) -> BaseException | None:
+        """Observe one wait; a withdrawal is separate from physical joining."""
+        import anyio  # noqa: PLC0415 -- optional backend
+
+        try:
+            await self.joined.wait()
+        except anyio.get_cancelled_exc_class() as error:
+            return error
+        return None
+
+    def retirement_failed(self) -> bool:
+        """Keep original retirement failures distinct from body delivery."""
+        if not self.joined.is_set():
+            raise RuntimeError('The original source owner is not joined')
+        return bool(
+            self.backend_errors
+            or (
+                self.outcome is not None
+                and (
+                    self.outcome.retirement_errors
+                    or self.outcome.observation_errors
+                )
+            )
+        )
+
+
+class SourceReader(AsyncIterator[T]):
+    """Non-owning demand view; it deliberately exposes no second aclose."""
+
+    def __init__(self, runtime: _SourceRuntime[T]) -> None:
+        self._runtime = runtime
+
+    def __aiter__(self) -> SourceReader[T]:
+        """Return the sole non-owning demand reader."""
+        return self
+
+    async def __anext__(self) -> T:
+        """Acknowledge the prior frame or observe a joined original failure."""
+        present, value = await self._runtime.handoff.pull()
+        if present:
+            return cast('T', value)
+        if self._runtime.joined.is_set():
+            error = self._runtime.terminal_error()
+            if error is not None:
+                raise error
+        raise StopAsyncIteration
+
+    def request_stop(self) -> None:
+        """Withdraw demand without claiming that resources have retired."""
+        self._runtime.handoff.request_stop()
+
+    def raise_if_retirement_failed(self) -> None:
+        """Prevent known close failures becoming ordinary protocol payloads.
+
+        Pending retirement is not successful retirement. The context still
+        owns and joins that pending work; this hook reports only facts already
+        established by the actual original group's physical exit.
+        """
+        if self._runtime.joined.is_set() and self._runtime.retirement_failed():
+            error = self._runtime.terminal_error()
+            if error is None:
+                raise RuntimeError('Failed retirement has no original error')
+            raise error
+
+
+@asynccontextmanager
+async def standalone_source_lifetime(
+    acquire: SourceFactory[T],
+) -> AsyncIterator[SourceReader[T]]:
+    """Admit one producer and join it before leaving the ASGI request root.
+
+    Use this context around BOTH dispatch and response execution. The source
+    factory, iterator operations and registered retirement run in the one
+    original producer, using the shared body mechanism. A blocked original
+    body/close keeps this context pending; caller cancellation is not an ACK.
+    Reading or projecting an original error cannot acknowledge a successful
+    lifetime: opaque iteration/callback code can contain its own finalizers,
+    whose failures are not distinguished by a later successful aclose.
+    """
+    import anyio  # noqa: PLC0415 -- optional backend
+
+    from anyio.lowlevel import checkpoint_if_cancelled  # noqa: PLC0415
+
+    runtime = _SourceRuntime(acquire)
+    observations: list[BaseException] = []
+    admitted = False
+    try:
+        with anyio.CancelScope(shield=True) as retirement:
+            async with anyio.create_task_group() as monitors:
+                try:
+                    await monitors.start(runtime.monitor)
+                    admitted = True
+                    runtime.dispatch.set()
+                    retirement.shield = False
+                    await checkpoint_if_cancelled()
+                    yield SourceReader(runtime)
+                except BaseException as error:  # noqa: BLE001 -- retained observer
+                    observations.append(error)
+                finally:
+                    retirement.shield = True
+                    runtime.handoff.request_stop()
+                    runtime.dispatch.set()
+                    # Wait for a monitor fact that follows the original group's
+                    # actual join. Keep repeated raw request-Task withdrawals
+                    # separate; never inject them into an active source finally.
+                    if admitted:
+                        while not runtime.joined.is_set():
+                            observation = await runtime.observe_join()
+                            if observation is not None:
+                                observations.append(observation)
+    except BaseException as error:  # noqa: BLE001 -- backend/scope exit is evidence
+        observations.append(error)
+    if runtime.joined.is_set():
+        error = runtime.terminal_error()
+        if error is not None:
+            observations.append(error)
+    error = _original_errors(observations)
+    if error is not None:
+        raise error
diff --git a/src/a2a/utils/source_ownership.py b/src/a2a/utils/source_ownership.py
new file mode 100644
index 0000000..d6f54d7
--- /dev/null
+++ b/src/a2a/utils/source_ownership.py
@@ -0,0 +1,343 @@
+"""The one-item source handoff, independent of scheduling and host authority.
+
+Derived from Kestrel's original-source iterator. A scheduler/host adapter owns
+admission, the original source Task, physical retirement and terminal errors.
+This mechanism never starts or cancels a Task. Requesting stop is NOT evidence
+that the source or its resources have retired.
+"""
+
+from __future__ import annotations
+
+import inspect
+
+from builtins import BaseExceptionGroup
+from collections import deque
+from collections.abc import AsyncIterable, AsyncIterator, Awaitable, Callable
+from contextlib import AbstractAsyncContextManager, asynccontextmanager
+from dataclasses import dataclass, field
+from typing import Generic, Protocol, TypeVar
+
+
+T = TypeVar('T')
+WaitContext = Callable[[], AbstractAsyncContextManager[None]]
+
+
+@asynccontextmanager
+async def _plain_wait() -> AsyncIterator[None]:
+    yield
+
+
+@dataclass
+class _Frame(Generic[T]):
+    value: T
+    acknowledged: _Signal = field(repr=False)
+    decision: bool | None = None
+
+    def acknowledge(self, *, proceed: bool) -> None:
+        if self.decision is None:
+            self.decision = proceed
+            self.acknowledged.set()
+
+
+class _Signal(Protocol):
+    def set(self) -> None: ...
+
+    async def wait(self) -> None: ...
+
+
+class SourceHandoff(Generic[T]):
+    """Serialize callback emissions through their individual ACK/Stop frames.
+
+    The consumer's next pull acknowledges its preceding frame. A cancelled
+    callback publisher retains that exact handoff before releasing its mutex;
+    another publisher cannot consume its ACK. Host writer release wraps the
+    mutex, and restoration completes before publisher code resumes.
+
+    ``pull()`` returning false only ends demand. The host must independently
+    join its original owner; neither stop nor an empty handoff proves cleanup.
+    """
+
+    def __init__(
+        self,
+        *,
+        yield_writer: WaitContext = _plain_wait,
+        wait_writer: WaitContext = _plain_wait,
+    ) -> None:
+        import anyio  # noqa: PLC0415 -- optional HTTP backend, never a base import
+
+        self._yield_writer = yield_writer
+        self._wait_writer = wait_writer
+        self._frames: deque[_Frame[T]] = deque()
+        self._ready = anyio.Event()
+        self._lock = anyio.Lock()
+        self._publishing: _Frame[T] | None = None
+        self._delivered: _Frame[T] | None = None
+        self._stopped = False
+        self._finished = False
+        self._reading = False
+
+    @property
+    def stopped(self) -> bool:
+        """Whether stop was requested, independently of physical retirement."""
+        return self._stopped
+
+    @property
+    def finished(self) -> bool:
+        """Whether the owner's adapter published its independent terminal fact."""
+        return self._finished
+
+    @property
+    def item_outstanding(self) -> bool:
+        """Whether demand has not yet acknowledged its delivered frame."""
+        return self._delivered is not None and self._delivered.decision is None
+
+    @property
+    def waiting_for_ack(self) -> bool:
+        """Whether an original publisher still owns its frame handoff."""
+        return self._publishing is not None
+
+    def request_stop(self) -> None:
+        """Stop demand cooperatively without cancelling any source Task."""
+        self._stopped = True
+        if self._publishing is not None:
+            self._publishing.acknowledge(proceed=False)
+        self._ready.set()
+
+    def publish_terminal(self) -> None:
+        """Publish an owner observation; does not invent or join that owner."""
+        self._finished = True
+        self._ready.set()
+
+    async def pull(self) -> tuple[bool, T | None]:
+        """Acknowledge the previous frame and receive the next demand result."""
+        import anyio  # noqa: PLC0415 -- optional HTTP backend
+
+        if self._reading:
+            raise RuntimeError(
+                'An original source has exactly one demand reader'
+            )
+        self._reading = True
+        try:
+            if self._delivered is not None:
+                self._delivered.acknowledge(proceed=True)
+                self._delivered = None
+            while not self._frames:
+                if self._stopped or self._finished:
+                    return False, None
+                async with self._wait_writer():
+                    await self._ready.wait()
+            if self._stopped:
+                return False, None
+            frame = self._frames.popleft()
+            if not self._frames:
+                self._ready = anyio.Event()
+            self._delivered = frame
+            return True, frame.value
+        finally:
+            self._reading = False
+
+    async def publish(self, value: T) -> bool:
+        """Retain this exact frame through its own ACK/Stop and restoration."""
+        import anyio  # noqa: PLC0415 -- optional HTTP backend
+
+        from anyio.lowlevel import checkpoint_if_cancelled  # noqa: PLC0415
+
+        if self._stopped:
+            return False
+        with anyio.CancelScope(shield=True) as scope:
+            async with self._yield_writer():
+                async with self._lock:
+                    scope.shield = False
+                    try:
+                        await checkpoint_if_cancelled()
+                    finally:
+                        scope.shield = True
+                    if self._stopped:
+                        return False
+                    if self._finished:
+                        raise RuntimeError(
+                            'Original source published after terminal observation'
+                        )
+                    frame = _Frame(value, anyio.Event())
+                    self._publishing = frame
+                    self._frames.append(frame)
+                    self._ready.set()
+                    cancellations: list[BaseException] = []
+                    try:
+                        while True:
+                            try:
+                                await frame.acknowledged.wait()
+                                break
+                            except anyio.get_cancelled_exc_class() as error:
+                                cancellations.append(error)
+                    finally:
+                        self._publishing = None
+                    if len(cancellations) == 1:
+                        raise cancellations[0]
+                    if cancellations:
+                        raise BaseExceptionGroup(
+                            'Original emission withdrawn', cancellations
+                        )
+        await checkpoint_if_cancelled()
+        return not self._stopped
+
+
+@dataclass(frozen=True)
+class CallbackSource(Generic[T]):
+    """A structured producer; false emission requests stop, never proves close.
+
+    The producer must join its children before returning None. The admitted
+    original owner runs the producer and retires its registered resources.
+    """
+
+    producer: Callable[[Callable[[T], Awaitable[bool]]], Awaitable[None]] = (
+        field(repr=False)
+    )
+
+    def __post_init__(self) -> None:
+        """Reject a non-callable producer without executing it."""
+        if not callable(self.producer):
+            raise TypeError('A callback source requires a callable producer')
+
+
+CloseResource = Callable[[], Awaitable[None] | None]
+
+
+def _require_none(result: object, operation: str) -> None:
+    if result is not None:
+        raise TypeError(f'An original {operation} must return None')
+
+
+async def _retire_resource(close: CloseResource) -> BaseException | None:
+    try:
+        result = close()
+        if inspect.isawaitable(result):
+            result = await result
+        _require_none(result, 'resource closer')
+    except BaseException as error:  # noqa: BLE001 -- original failure, not success
+        return error
+    return None
+
+
+class SourceAcquisition:
+    """Retain partial acquisitions before the factory's next fallible step.
+
+    Registrations have identity, not equality. This record supplies no Task
+    admission or execution authority. An undisclosed resource remains the
+    factory's exception-safety responsibility.
+    """
+
+    def __init__(self) -> None:
+        self._resources: list[tuple[object, CloseResource]] = []
+        self._closed = False
+
+    def retain(self, resource: T, close: CloseResource) -> T:
+        """Register exactly one original closer, then return its resource."""
+        if self._closed:
+            raise RuntimeError('Original source acquisition is closed')
+        if not callable(close):
+            raise TypeError('An acquired resource needs a callable closer')
+        if any(original is resource for original, _ in self._resources):
+            raise ValueError('An original resource is already registered')
+        self._resources.append((resource, close))
+        return resource
+
+    def retain_iterator(self, iterator: object) -> None:
+        """Retain an exposed iterator before its next acquisition/advancement."""
+        if any(original is iterator for original, _ in self._resources):
+            return
+        close = getattr(iterator, 'aclose', None)
+        if close is None:
+            return  # AsyncIterable does not require an aclose capability.
+        if not callable(close):
+            raise TypeError('An exposed aclose capability must be callable')
+        self.retain(iterator, close)
+
+    def retain_iterable(self, source: AsyncIterable[T]) -> AsyncIterator[T]:
+        """Retain source BEFORE aiter, then retain the actual iterator too."""
+        self.retain_iterator(source)
+        iterator = aiter(source)
+        self.retain_iterator(iterator)
+        return iterator
+
+    async def retire(self) -> tuple[BaseException, ...]:
+        """Attempt all original closers once, LIFO, retaining every failure."""
+        if self._closed:
+            raise RuntimeError('Original source retirement already ran')
+        self._closed = True
+        errors: list[BaseException] = []
+        for _resource, close in reversed(self._resources):
+            error = await _retire_resource(close)
+            if error is not None:
+                errors.append(error)
+        return tuple(errors)
+
+
+@dataclass(frozen=True)
+class SourceBodyOutcome:
+    """Body/retirement facts, separate from Task admission and reader withdrawal.
+
+    Returning this value is NOT the host owner's physical Task-join receipt.
+    Host epilogue and observation failures still belong to that actual owner.
+    """
+
+    body_error: BaseException | None = field(default=None, repr=False)
+    retirement_errors: tuple[BaseException, ...] = field(default=(), repr=False)
+    observation_errors: tuple[BaseException, ...] = field(
+        default=(), repr=False
+    )
+
+
+async def run_source_body(
+    acquire: Callable[
+        [SourceAcquisition], AsyncIterable[T] | CallbackSource[T]
+    ],
+    handoff: SourceHandoff[T],
+    *,
+    on_body_error: Callable[[BaseException], None] | None = None,
+) -> SourceBodyOutcome:
+    """Run acquisition, demand and retirement in the admitted caller's Task.
+
+    This is the shared body mechanism, NOT a scheduler or admission boundary.
+    The host must invoke it behind its accepted owner's dispatch gate, retain
+    that exact owner and publish terminal demand only after observing the owner.
+    Neither this function nor a reader may cancel an unknown active finally.
+    """
+    import anyio  # noqa: PLC0415 -- optional HTTP backend
+
+    resources = SourceAcquisition()
+    body_error: BaseException | None = None
+    observation_errors: list[BaseException] = []
+    retirement_errors: tuple[BaseException, ...] = ()
+    try:
+        with anyio.CancelScope(shield=True):
+            try:
+                source = acquire(resources)
+                if isinstance(source, CallbackSource):
+                    result = await source.producer(handoff.publish)
+                    _require_none(result, 'callback producer')
+                else:
+                    iterator = resources.retain_iterable(source)
+                    while True:
+                        try:
+                            item = await anext(iterator)
+                        except StopAsyncIteration:
+                            break
+                        if not await handoff.publish(item):
+                            break
+            except BaseException as error:  # noqa: BLE001 -- retain ALL original control
+                body_error = error
+                if on_body_error is not None:
+                    try:
+                        on_body_error(error)
+                    except BaseException as observation_error:  # noqa: BLE001 -- independent evidence
+                        observation_errors.append(observation_error)
+            finally:
+                retirement_errors = await resources.retire()
+    except BaseException as scope_error:  # noqa: BLE001 -- scope retirement is not ACKed
+        # Include failure of the original backend scope's exit itself. It is
+        # neither successful cleanup nor the request observer's withdrawal.
+        retirement_errors = (*retirement_errors, scope_error)
+    return SourceBodyOutcome(
+        body_error, retirement_errors, tuple(observation_errors)
+    )
